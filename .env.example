# Sentenza – Beispielkonfiguration
#
# Diese Datei listet jede von Sentenza_Backend oder Sentenza_Extension gelesene
# Umgebungsvariable mit einem Platzhalterwert (Requirement 1.8). Keiner der
# Werte hier ist ein echtes Zugangsdatum.
#
# Kopieren nach `.env` und Platzhalter durch echte Werte ersetzen. `.env`
# selbst wird nicht eingecheckt (siehe .gitignore).

# --- Datenbank ------------------------------------------------------------
# Verbindung zur PostgreSQL-Instanz
DATABASE_URL=postgresql://sentenza:sentenza@localhost:5432/sentenza
# Verbindung zur Testdatenbank
TEST_DATABASE_URL=postgresql://sentenza:sentenza@localhost:5433/sentenza_test

# --- Server ----------------------------------------------------------------
# Port der GraphQL_API (Requirement 1.9)
PORT=4000
# Frist für die Datenbankverbindung beim Start, in Millisekunden (Requirement 1.12)
DB_STARTUP_TIMEOUT_MS=60000

# --- Google-Anmeldung / Auth -------------------------------------------
# Erwarteter `aud` des Google_ID_Token
GOOGLE_CLIENT_ID=<google-client-id>
# Erwarteter `iss`
GOOGLE_ISSUER=https://accounts.google.com
# Quelle der Google-JWKS
GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
# Abbruch des JWKS-Abrufs, in Millisekunden (Requirement 2.1, 2.13)
GOOGLE_JWKS_TIMEOUT_MS=5000
# Konto_Freigabeliste, kommagetrennt. Ohne diese Liste erhält kein Konto Zugang;
# mit einer zu weiten Liste könnte jedes Google-Konto in die Datenbank schreiben.
AUTH_ALLOWED_EMAILS=du@example.com
# Signaturgeheimnis der Sentenza-Access-Tokens. Echten, zufällig erzeugten Wert
# nur in der lokalen .env eintragen, niemals hier.
JWT_SECRET=<zufallswert>
# Gültigkeit des Access-Tokens in Minuten, zulässig 5–60 (Requirement 2.6)
ACCESS_TOKEN_TTL_MINUTES=15
# Gültigkeit des Refresh-Tokens in Tagen (Requirement 2.5)
REFRESH_TOKEN_TTL_DAYS=30

# --- Ingestion / Normalisierung ------------------------------------------
# Größenbegrenzung der Einreichung in Byte (Requirement 3.8)
INGESTION_MAX_PAYLOAD_BYTES=10485760
# Zielsprache für Themen aus Lernstands-Payloads (Requirement 5.4)
DEFAULT_TARGET_LANGUAGE=es

# --- Protokollierung --------------------------------------------------------
# Protokollschwelle
LOG_LEVEL=info

# --- Chrome Extension -------------------------------------------------------
# Adresse der GraphQL_API, die die Extension anspricht
SENTENZA_BACKEND_URL=http://localhost:4000/graphql
# Client-Kennung für chrome.identity.launchWebAuthFlow
SENTENZA_GOOGLE_CLIENT_ID=<google-client-id>
