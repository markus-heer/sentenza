{
  "name": "@sentenza/backend",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "build": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run",
    "start:dev": "dotenv -e ../../.env -- tsx watch src/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@prisma/client": "6.19.3",
    "@sentenza/domain": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@sentenza/eslint-config": "workspace:*",
    "@sentenza/typescript-config": "workspace:*",
    "@sentenza/vitest-config": "workspace:*",
    "@types/node": "22.20.4",
    "dotenv-cli": "10.0.0",
    "fast-check": "4.10.2",
    "prisma": "6.19.3",
    "tsx": "4.20.5",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  }
}
