{
  "name": "@sentenza/backend",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "build": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run",
    "start:dev": "dotenv -e ../../.env -- node --watch --require @swc-node/register src/main.ts"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.0.2",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/graphql": "14.0.2",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/terminus": "12.1.0",
    "@prisma/client": "6.19.3",
    "@sentenza/domain": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "graphql": "16.11.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@sentenza/eslint-config": "workspace:*",
    "@sentenza/typescript-config": "workspace:*",
    "@sentenza/vitest-config": "workspace:*",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.2",
    "@types/node": "22.20.4",
    "dotenv-cli": "10.0.0",
    "fast-check": "4.10.2",
    "prisma": "6.19.3",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  }
}
