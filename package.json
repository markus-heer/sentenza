{
  "name": "sentenza",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "build": "turbo run build",
    "test": "turbo run test",
    "postinstall": "pnpm --filter @sentenza/backend db:generate"
  },
  "devDependencies": {
    "@sentenza/eslint-config": "workspace:*",
    "eslint": "9.17.0",
    "prettier": "3.9.9",
    "turbo": "2.3.3"
  }
}
